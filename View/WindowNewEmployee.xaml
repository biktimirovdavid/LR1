<Window x:Class="LR1.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сотрудник" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Код:" Margin="10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Margin="10" IsReadOnly="True"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Должность:" Margin="10" VerticalAlignment="Center"/>
        
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbRole" Margin="10" 
                  DisplayMemberPath="NameRole"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Фамилия:" Margin="10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LastName}" Margin="10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Имя:" Margin="10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FirstName}" Margin="10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата рождения:" Margin="10" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Birthday}" Margin="10"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Width="100" Height="30" Margin="10" Click="Save_Click"/>
            <Button Content="Отменить" Width="100" Height="30" Margin="10" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
