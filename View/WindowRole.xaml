<Window x:Class="LR1.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Должности" Height="300" Width="300">
    <StackPanel Background="#FFD8D8D8">
        <StackPanel Orientation="Horizontal" Background="#FFE4E9E0">
            <Button Content="Добавить" Height="25" Margin="10,10,5,10" Command="{Binding AddRole}"/>
            <Button Content="Редактировать" Height="25" Margin="10,10,5,10" Command="{Binding EditRole}"/>
            <Button Content="Удалить" Height="25" Margin="10,10,5,10" Command="{Binding DeleteRole}"/>
        </StackPanel>
        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>
        <ListView ItemsSource="{Binding ListRole}" SelectedItem="{Binding SelectedRole}" Background="#FFD3CDCD">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Наименование должности" DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
